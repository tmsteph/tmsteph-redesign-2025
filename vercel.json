{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "dest": "https://tmsteph.vercel.app/"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "https://tmsteph.vercel.app/css/$1"
    },
    {
      "src": "^/favicon-16x16\\.png$",
      "dest": "https://tmsteph.vercel.app/favicon-16x16.png"
    },
    {
      "src": "^/manifest\\.webmanifest$",
      "dest": "https://tmsteph.vercel.app/manifest.webmanifest"
    },
    {
      "handle": "filesystem"
    }
  ]
}
